# =============================================================================
# BIẾN MÔI TRƯỜNG — Trợ lý giọng nói AI hỗ trợ TTHC trực tuyến (phường Yên Sở)
# Sao chép file này thành `.env` và điền giá trị thật.
# TUYỆT ĐỐI KHÔNG commit file `.env` (đã có trong .gitignore).
# =============================================================================

# ---------- Ứng dụng ----------
APP_ENV=development                 # development | staging | production
SECRET_KEY=change-me-to-a-random-32-byte-secret
JWT_EXPIRE_HOURS=8

# ---------- PostgreSQL ----------
DATABASE_URL=postgresql+asyncpg://app_user:app_password@localhost:5432/tthc_ai

# ---------- Redis ----------
REDIS_URL=redis://localhost:6379/0

# ---------- Nhà cung cấp AI (chọn provider) ----------
STT_PROVIDER=mock                   # mock | blaze
TTS_PROVIDER=mock                   # mock | blaze
LLM_PROVIDER=claude                 # mock | claude | gemini

# ---------- Claude API (Anthropic) ----------
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2

# ---------- Gemini API (Google) ----------
# Tạo key tại: https://aistudio.google.com/apikey — chỉ cần điền khi
# LLM_PROVIDER=gemini.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ---------- Blaze API ----------
# Tài liệu: https://api.blaze.vn — xác thực bằng Bearer token dùng chung
# cho mọi sản phẩm (TTS, STT, Voicebot, Voice Management...).
# Tạo token tại: Blaze Dashboard > API Tokens > Create token.
BLAZE_API_TOKEN=
BLAZE_BASE_URL=https://api.blaze.vn
BLAZE_WS_BASE_URL=wss://api.blaze.vn

# --- STT (Speech-to-Text) ---
# Non-streaming (dùng cho amend một trường / xử lý file ngắn):
#   POST {BLAZE_BASE_URL}/v1/stt/execute?model=stt-async-1.5
# Streaming (dùng cho luồng ghi âm chính tại quầy):
#   WS   {BLAZE_WS_BASE_URL}/v1/stt/realtime  (model: stt-stream-1.5)
BLAZE_STT_ASYNC_MODEL=stt-async-1.5
BLAZE_STT_STREAM_MODEL=stt-stream-1.5
BLAZE_STT_LANGUAGE=vi
# Tùy chọn — chỉ hỗ trợ với stt-stream-1.5, giúp tăng độ chính xác thuật ngữ
# hành chính (tên thủ tục, địa danh...). Điền khi đã có bộ từ khóa chuẩn.
BLAZE_STT_TOPIC=Thủ tục hành chính tại Tổ chuyển đổi số cộng đồng
BLAZE_STT_CONTEXT=Kê khai hồ sơ hành chính công tại quầy hỗ trợ phường Yên Sở
BLAZE_STT_BIAS_KEYWORDS=khai sinh,kết hôn,khai tử,chứng thực,căn cước công dân,thường trú

# --- TTS (Text-to-Speech) ---
# Batch:      POST {BLAZE_BASE_URL}/v1/tts
# Real-time:  WS   {BLAZE_WS_BASE_URL}/v1/tts/realtime
BLAZE_TTS_MODEL=v2.0_pro
BLAZE_TTS_REALTIME_MODEL=2.0-realtime
BLAZE_TTS_SPEAKER_ID=HN-Nam-1-BL     # Giọng miền Bắc — cần nghe thử, chọn giọng phù hợp phường Yên Sở
BLAZE_TTS_LANGUAGE=vi
BLAZE_TTS_AUDIO_FORMAT=mp3           # pcm | mp3 | opus | wav
BLAZE_TTS_AUDIO_QUALITY=64
BLAZE_TTS_AUDIO_SPEED=1
BLAZE_TTS_NORMALIZATION=basic
BLAZE_TTS_PCM_SAMPLE_RATE=24000      # chỉ dùng khi audio_format=pcm

# ---------- Danh sách nhà cung cấp AI được duyệt (NT-10) ----------
# Mọi hostname KHÔNG có trong danh sách này sẽ bị chặn ở tầng code.
APPROVED_AI_HOSTS=api.anthropic.com,api.blaze.vn

# ---------- Ngưỡng nghiệp vụ ----------
STT_MIN_CONFIDENCE=0.65
MAX_EXTRACTIONS_PER_SESSION=5
MAX_RECORDING_SECONDS=120
AUDIO_BUFFER_TTL_SECONDS=120
MAX_CONCURRENT_SESSIONS_PER_STAFF=3

# ---------- Thời hạn lưu trữ (cần chốt với đơn vị chủ trì — xem Plan.MD Mục 20) ----------
TRANSCRIPT_RETENTION_DAYS=90
AUDIT_RETENTION_DAYS=730

# ---------- CORS ----------
FRONTEND_ORIGIN=http://localhost:5173
